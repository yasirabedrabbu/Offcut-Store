{
  "name": "offcut-store",
  "version": "1.0.0",
  "description": "Offcut streetwear store with 3D clothing rail hero, built with Next.js",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check-lines": "node scripts/check-lines.mjs",
    "check-banned-css": "node scripts/check-banned-css.mjs",
    "check": "npm run typecheck && npm run lint && npm run check-lines && npm run check-banned-css && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "19.3.3",
    "typescript": "5.8.2"
  }
}
